<Window x:Class="ChestCounter.CloudWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="Save na Nuvem — Fortnite ChestCounter"
        Width="460"
        SizeToContent="Height"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        Background="#0B0F19"
        Foreground="#E2E8F0"
        FontFamily="Segoe UI, Arial, sans-serif">

    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="40" ResizeBorderThickness="0" GlassFrameThickness="0" CornerRadius="8"/>
    </shell:WindowChrome.WindowChrome>

    <Window.Resources>
        <Style x:Key="DarkInput" TargetType="TextBox">
            <Setter Property="Background" Value="#080C15"/>
            <Setter Property="Foreground" Value="#F8FAFC"/>
            <Setter Property="CaretBrush" Value="#F59E0B"/>
            <Setter Property="BorderBrush" Value="#253248"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="10,8"/>
            <Setter Property="FontSize" Value="13"/>
        </Style>
        <Style x:Key="DarkPass" TargetType="PasswordBox">
            <Setter Property="Background" Value="#080C15"/>
            <Setter Property="Foreground" Value="#F8FAFC"/>
            <Setter Property="CaretBrush" Value="#F59E0B"/>
            <Setter Property="BorderBrush" Value="#253248"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="10,8"/>
            <Setter Property="FontSize" Value="13"/>
        </Style>
        <Style x:Key="PrimaryBtn" TargetType="Button">
            <Setter Property="Background" Value="#F59E0B"/>
            <Setter Property="Foreground" Value="#0B0F19"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="14,9"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#FBBF24"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.55"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="SecondaryBtn" TargetType="Button">
            <Setter Property="Background" Value="#142338"/>
            <Setter Property="Foreground" Value="#38BDF8"/>
            <Setter Property="BorderBrush" Value="#1E3A5F"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="14,9"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#1C314D"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.55"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border BorderBrush="#1E293B" BorderThickness="1" Background="#0B0F19">
        <StackPanel>
            <!-- Custom Titlebar -->
            <Grid Height="40" Background="#080C14">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="14,0,0,0">
                    <TextBlock Text="☁" FontSize="15" Foreground="#38BDF8" VerticalAlignment="Center" Margin="0,0,8,0"/>
                    <TextBlock Text="SAVE NA NUVEM (RENDER)" FontSize="12" FontWeight="Bold" Foreground="#F8FAFC" VerticalAlignment="Center"/>
                </StackPanel>
                <Button Grid.Column="1" Width="40" Height="40" Content="✕" FontSize="12" Foreground="#94A3B8" Background="Transparent" BorderThickness="0"
                        Cursor="Hand" Click="BtnClose_Click" shell:WindowChrome.IsHitTestVisibleInChrome="True"/>
            </Grid>

            <Border Height="1" Background="#1E293B"/>

            <StackPanel Margin="20,16,20,20">
                <TextBlock Text="Guarde seu total de baús, partidas e sessão atual na nuvem. Se formatar o PC ou entrar em outro computador, basta fazer login."
                           TextWrapping="Wrap" FontSize="12" Foreground="#94A3B8" Margin="0,0,0,14"/>

                <!-- Login / Register View -->
                <StackPanel x:Name="PanelLogin">
                    <TextBlock Text="LINK DO SERVIDOR NO RENDER" FontSize="11" FontWeight="SemiBold" Foreground="#CBD5E1" Margin="0,0,0,4"/>
                    <TextBox x:Name="TxtUrl" Style="{StaticResource DarkInput}" Margin="0,0,0,3"/>
                    <TextBlock Text="Ex: https://seu-app.onrender.com (seu Web Service conectado ao Postgres)"
                               FontSize="10.5" Foreground="#64748B" Margin="0,0,0,12"/>

                    <TextBlock Text="USUÁRIO" FontSize="11" FontWeight="SemiBold" Foreground="#CBD5E1" Margin="0,0,0,4"/>
                    <TextBox x:Name="TxtUser" Style="{StaticResource DarkInput}" Margin="0,0,0,3"/>
                    <TextBlock Text="3 a 24 caracteres (letras, números, _ . -)"
                               FontSize="10.5" Foreground="#64748B" Margin="0,0,0,12"/>

                    <TextBlock Text="SENHA" FontSize="11" FontWeight="SemiBold" Foreground="#CBD5E1" Margin="0,0,0,4"/>
                    <PasswordBox x:Name="TxtPassword" Style="{StaticResource DarkPass}" KeyDown="TxtPassword_KeyDown" Margin="0,0,0,3"/>
                    <TextBlock Text="Mínimo de 8 caracteres (armazenada com criptografia bcrypt no banco)"
                               FontSize="10.5" Foreground="#64748B" Margin="0,0,0,14"/>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="10"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Button x:Name="BtnLogin" Grid.Column="0" Content="Entrar" Style="{StaticResource PrimaryBtn}" Click="BtnLogin_Click"/>
                        <Button x:Name="BtnRegister" Grid.Column="2" Content="Criar Conta" Style="{StaticResource SecondaryBtn}" Click="BtnRegister_Click"/>
                    </Grid>

                    <TextBlock Text="ℹ No plano gratuito do Render, a primeira conexão pode levar ~40s para acordar o servidor."
                               TextWrapping="Wrap" FontSize="11" Foreground="#64748B" Margin="0,12,0,0"/>
                </StackPanel>

                <!-- Connected View -->
                <StackPanel x:Name="PanelConnected" Visibility="Collapsed">
                    <Border Background="#0E1726" BorderBrush="#1E293B" BorderThickness="1" CornerRadius="8" Padding="14" Margin="0,0,0,14">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                <Ellipse Width="8" Height="8" Fill="#10B981" VerticalAlignment="Center" Margin="0,0,7,0"/>
                                <TextBlock x:Name="TxtAccountUser" Text="Conectado" FontSize="14" FontWeight="Bold" Foreground="#F8FAFC"/>
                            </StackPanel>
                            <TextBlock x:Name="TxtAccountServer" Text="Servidor: —" FontSize="11.5" Foreground="#94A3B8" TextTrimming="CharacterEllipsis" Margin="0,0,0,6"/>
                            <TextBlock x:Name="TxtLocalSummary" Text="Local: —" FontSize="12" Foreground="#CBD5E1" Margin="0,0,0,4"/>
                            <TextBlock x:Name="TxtLastSync" Text="Última sincronização: agora" FontSize="11.5" Foreground="#64748B"/>
                        </StackPanel>
                    </Border>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="10"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <Button x:Name="BtnSync" Grid.Column="0" Content="↻ Sincronizar Agora" Style="{StaticResource PrimaryBtn}" Click="BtnSync_Click"/>
                        <Button x:Name="BtnLogout" Grid.Column="2" Content="Sair da Conta" Background="#2A1218" Foreground="#FCA5A5" BorderBrush="#7F1D1D" BorderThickness="1"
                                Padding="14,9" FontWeight="SemiBold" FontSize="13" Cursor="Hand" Click="BtnLogout_Click">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>
                    </Grid>
                </StackPanel>

                <!-- Feedback Banner -->
                <Border x:Name="BannerStatus" Visibility="Collapsed" Background="#0E1726" BorderBrush="#1E293B" BorderThickness="1" CornerRadius="6" Padding="10,8" Margin="0,12,0,0">
                    <TextBlock x:Name="TxtStatus" TextWrapping="Wrap" FontSize="12" Foreground="#CBD5E1"/>
                </Border>
            </StackPanel>
        </StackPanel>
    </Border>
</Window>
